# Real local secrets/values for `docker compose`. This file is gitignored
# (see .gitignore) — copy .env.example to .env and change the values if you
# want non-default secrets. Compose reads it automatically from the project
# root and substitutes ${VAR} in docker-compose.yml; ${VAR:-default} falls
# back to the value below when the var is missing, so `docker compose up`
# works out-of-the-box.
POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=gateway_secure_password
POSTGRES_DB=gateway_db
JWT_SECRET=gateway_secret_is_super_secure
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest